{%- comment -%}
  OnRepeat Money Back Promise — compact dark-maroon trust card for the PDP (hero
  of the three trust blocks). Rendered by the `liquid_84KaBD` custom-liquid
  block on the product templates. Links to Razorpay's Money Back Promise.

  Clean + calm: a single compact row (coin · title + refund line · COD pill),
  no looping animations. The background / colours / text-decoration are forced
  with !important so the theme's own `.product__info a` / `.rte a` link rules
  (which otherwise render the card white with an invisible underline) can't
  override them.
{%- endcomment -%}

<style>
  .smb {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin: 10px 0;
    box-sizing: border-box;
    padding: 14px 15px;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none !important;
    color: #FFF0F4 !important;
    /* `background` SHORTHAND (not longhands) so the theme's `.rte a`
       underline (background-position/size/repeat) is reset and can't squash
       the gradient into a 1px line. */
    background:
      radial-gradient(150px 110px at 86% 12%, rgba(140,28,62,0.45) 0%, transparent 72%),
      linear-gradient(150deg, #220a11 0%, #12060a 100%) #14060a !important;
    border: 1px solid rgba(220, 90, 120, 0.20);
    box-shadow: 0 10px 26px -14px rgba(120, 25, 55, 0.6), inset 0 1px 0 rgba(255, 210, 225, 0.07);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s ease, border-color 0.3s ease !important;
    -webkit-user-select: none;
    user-select: none;
  }
  .smb::before, .smb::after { content: none !important; } /* kill any theme a::before/::after underline */
  .smb:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -14px rgba(200, 40, 80, 0.5);
    border-color: rgba(255, 120, 150, 0.34);
  }

  .smb__coin {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    font-weight: 800;
    line-height: 1;
    color: #FFD6E0 !important;
    background: linear-gradient(135deg, #8A1C3E 0%, #4A0E20 100%);
    box-shadow: 0 0 14px rgba(184, 46, 86, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.2);
  }

  .smb__t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .smb__name {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.1;
    color: #FFF0F4 !important;
  }
  .smb__sub {
    font-size: 11.5px;
    font-weight: 400;
    line-height: 1.2;
    color: rgba(232, 196, 205, 0.85) !important;
  }
  .smb__sub strong { font-weight: 700; color: #FFE2E8 !important; }

  .smb__pill {
    flex-shrink: 0;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.4px;
    white-space: nowrap;
    color: #FFC4D4 !important;
    padding: 4px 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(140, 20, 50, 0.65), rgba(100, 15, 35, 0.65));
    border: 1px solid rgba(220, 80, 110, 0.34);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 380px) {
    .smb { padding: 12px 13px; gap: 10px; }
    .smb__name { font-size: 14px; }
    .smb__sub { font-size: 11px; }
    .smb__pill { font-size: 9px; padding: 4px 8px; }
  }
</style>

<a class="smb" href="https://razorpay.com/terms/money-back-promise/" target="_blank" rel="noopener noreferrer" aria-label="The OnRepeat Money Back Promise — 100% refund on non-delivery or defects">
  <span class="smb__coin" aria-hidden="true">₹</span>
  <span class="smb__t">
    <span class="smb__name">Money Back Promise</span>
    <span class="smb__sub"><strong>100% refund</strong> on non-delivery or defects</span>
  </span>
  <span class="smb__pill">COD &amp; Prepaid</span>
</a>
