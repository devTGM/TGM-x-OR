{%- comment -%}
  Renders a product card

  Accepts:
  - product: {Object} Product Liquid object (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - image_ratio: {String} Size of the product image card. Values are "square", "landscape" and "portrait". Default is "square" (optional)
  - image_fill: {Boolean} Zoom image to fill space. Default: false (optional)
  - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: false
  - show_countdown: {Boolean} Show the countdown timer.
  - show_quick_add: {Boolean} Show the quick add button.
  - show_quick_view: {Boolean} Show the quick view button.
  - show_color_swatches: {Boolean} Show the color swatches.
  - show_save_amount: {Boolean} Show save amount.
  - amount_type: {String} Save amount type.
  - product_id: {String} The ID of the current product.
  - section_id: {String} The ID of the section that contains this card.

  Usage:
  {% render 'product-card', show_vendor: section.settings.show_vendor %}
{%- endcomment -%}

{%- comment -%}
  Card styles ship with the card, the way onrepeat-rotating-tag, onrepeat-gsm-badge,
  buy-buttons and six other snippets in this theme already load theirs. The tag
  repeats per card and the browser dedupes it to one request; keeping it here
  rather than in layout/theme.liquid means the card is self-contained and the
  layout — every app embed on the site — is never touched to restyle a card.
{%- endcomment -%}
{{ 'onrepeat-product-card.css' | asset_url | stylesheet_tag }}

{%- if product != blank -%}
  {%- liquid
    assign featured_media = product.featured_media

    assign product_url = product.url | within: collection
    if settings.product_disable_collection_portion
      assign product_url = product.url
    endif

    assign card_swipe = false
    if settings.product_card_swipe and product.media.size > 1 and featured_media.media_type == 'image'
      assign card_swipe = true
    endif

    comment
      The colourway lives inside the product title ("CORD Knit Polo — Slate"),
      which on a 2-up card truncated to "CORD KNIT POLO — S…" and told a shopper
      nothing. Split on the em dash: the family name becomes the title, the
      colour drops to its own muted line beside the price. Same split the
      colour-swatches snippet already uses to name a sibling, so the two always
      agree. A product with no dash keeps its full title and shows no colour.
    endcomment
    assign card_title = product.title
    assign card_colour = ''
    if product.title contains '—'
      assign card_title = product.title | split: '—' | first | strip
      assign card_colour = product.title | split: '—' | last | strip
    endif

    comment
      Rating is computed here rather than over the photograph — see the info
      block below, where it now sits next to the price.
    endcomment
    assign card_rating_show = false
    if show_rating
      assign rating_max = 5
      if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0
        assign rating_value = product.metafields.reviews.rating.value.rating | round: 1
        assign rating_count = product.metafields.reviews.rating_count.value
        assign rating_max = product.metafields.reviews.rating.value.scale_max
        assign card_rating_show = true
      elsif show_empty
        assign rating_value = 0.0
        assign rating_count = 0
        assign card_rating_show = true
      elsif show_placeholder
        assign rating_value = 4.5
        assign rating_count = 2
        assign card_rating_show = true
      endif
    endif

    comment
      Size availability, straight on the card. Only M/L/XL exist on most of the
      range and some are gone, so making a shopper open the product to find that
      out is a wasted trip. Values are collected from the variants (not from
      `option.values`, whose members are objects on newer versions and so cannot
      be compared to `variant.options[i]`), pipe-delimited on both sides so a
      `contains` test for "S" can never match inside "XS".
    endcomment
    assign size_index = -1
    assign size_option_name = ''
    for card_option in product.options_with_values
      assign option_down = card_option.name | downcase
      if option_down contains 'size'
        assign size_index = forloop.index0
        assign size_option_name = card_option.name
        break
      endif
    endfor

    assign sizes_all = '|'
    assign sizes_live = '|'
    if size_index >= 0
      for card_variant in product.variants
        assign size_value = card_variant.options[size_index]
        capture size_key
          echo '|'
          echo size_value
          echo '|'
        endcapture
        unless sizes_all contains size_key
          assign sizes_all = sizes_all | append: size_value | append: '|'
        endunless
        if card_variant.available
          unless sizes_live contains size_key
            assign sizes_live = sizes_live | append: size_value | append: '|'
          endunless
        endif
      endfor
    endif
    assign sizes_list = sizes_all | split: '|'
  -%}
  <div class="card product-card product-card--{{ settings.card_style }}{% if settings.card_border_thickness > 0 %} product-card--thickness{% endif %}{% unless featured_media %} no-media{% endunless %}{% unless product.available %} product-card--soldout{% endunless %}{% if product.available and show_quick_add and mobile_quick_add %} mobile:with-quick-add{% endif %} flex flex-col leading-none relative overflow-hidden">
    {%- if featured_media -%}
      <div class="product-card__media relative h-auto{% unless show_secondary_image and product.media.size > 1 %} overflow-hidden{% endunless %}">
        {%- if show_quick_view -%}
          <button type="button" class="quick-view__button button button--secondary z-2 absolute top-0 right-0 opacity-0" is="hover-button" aria-controls="Quickview-{{ section_id }}-{{ product_id }}" aria-expanded="false">
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'eye', size: 'sm' -%}
              <span class="sr-only">{{ 'products.product.quick_view' | t }}</span>
            </span>
          </button>
          <quick-view id="Quickview-{{ section_id }}-{{ product_id }}" class="quick-view x-modal drawer z-40 fixed bottom-0 left-0 h-full w-full pointer-events-none" data-product-url="{{ product_url }}" role="dialog" aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}" aria-modal="true">
            <overlay-element class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none" aria-controls="Quickview-{{ section_id }}-{{ product_id }}" aria-expanded="false"></overlay-element>
            <div class="drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden">
              <gesture-element class="drawer__header flex justify-between opacity-0 invisible relative">
                <button class="button button--secondary button--close drawer__close z-1 absolute top-0 right-0 flex items-center justify-center opacity-0" type="button" is="hover-button" aria-controls="Quickview-{{ section_id }}-{{ product_id }}" aria-expanded="false" aria-label="{{ 'general.accessibility.close' | t | escape }}">
                  <span class="btn-fill" data-fill></span>
                  <span class="btn-text">
                    {%- render 'icon', icon: 'close', size: 'sm' -%}
                  </span>
                </button>
              </gesture-element>
              <div class="quick-view__content drawer__content opacity-0 invisible flex flex-col h-full grow shrink"></div>
            </div>
          </quick-view>
        {%- endif -%}

        {%- comment -%}
          The rating chip used to float here, over the bottom-left of the
          photograph, where it competed with the quick-add button and the image
          dots for the same strip of image. It now sits in the info block beside
          the price, which is where a shopper reads the rest of the numbers.
        {%- endcomment -%}
        {%- render 'product-badges', product: product, show_save_amount: show_save_amount, save_type: save_type, class: 'z-2 absolute grid gap-3' -%}

        <a class="block relative media media--{{ image_ratio }}{% unless image_fill %} media--contain{% endunless %}{% unless show_secondary_image and product.media.size > 1 %} overflow-hidden{% endunless %}" href="{{ product_url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
          {%- unless featured_media.media_type == 'video' or featured_media.media_type == 'external_video' -%}
            {%- if card_swipe -%}
              <template>
                {%- for media in product.media limit: 5 -%}
                  {%- if media.media_type == 'image' -%}
                    <div class="media media--height{% unless image_fill %} media--contain{% endunless %} w-full h-full overflow-hidden">
                      {{- media | image_url: width: media.width | image_tag: loading: 'lazy', sizes: 'auto', decoding: 'async', widths: '180,360,540,720,900,1080', is: 'lazy-image' -}}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </template>
              <card-swipe class="card-swipe block absolute top-0 left-0 w-full h-full" aria-label="{{ product.title | escape }} — image gallery"></card-swipe>
            {%- endif -%}

            {{- featured_media | image_url: width: featured_media.width | image_tag: loading: 'lazy', sizes: 'auto', decoding: 'async', widths: '180,360,540,720,900,1080', is: 'lazy-image' -}}
          {%- else -%}
            {%- comment -%}
              Card videos play silently and loop while the card is on screen
              (video-media's own in-view observer starts and stops them), so
              there is no play button to press — tapping the card still opens
              the product, because the video sits inside the product link.
            {%- endcomment -%}
            {%- render 'product-video',
              video: featured_media,
              muted: true,
              autoplay: true,
              loop: true,
              cover_image: featured_media,
              show_play_button: false,
              class: 'relative w-full overflow-hidden'
            -%}
          {%- endunless -%}
        </a>

        {%- comment -%}
          Nothing is rendered here when the product is sold out. Sold out is
          stated ONCE — by the badge in `product-badges` plus the desaturated
          photo (.product-card--soldout). The disabled "Sold Out" button that
          used to sit in this slot printed that word a second time and, being
          centred in the same bottom band as the old rating chip, overlapped it
          on narrow (2-up) cards.
        {%- endcomment -%}
        {%- if product.available -%}
          {%- if show_quick_add -%}
            <div class="quick-add flex justify-end md:justify-center absolute w-full z-1 pointer-events-none">
              {%- if product.variants.size == 1 -%}
                {%- capture product_form_id -%}QuickAddProductForm-{{ section_id }}-{{ product_id }}{%- endcapture -%}
                {%- form 'product', product, is: 'product-form', id: product_form_id -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
                  {%- liquid
                    if product.template_suffix != 'pre-order'
                      assign quick_add_label = 'products.product.add_to_cart' | t
                    else
                      assign quick_add_label = 'products.product.pre_order' | t
                    endif
                  -%}
                  <button type="submit" class="button button--primary pointer-events-auto md:opacity-0" is="hover-button" data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="{{ quick_add_label | escape }}">
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">
                      {%- render 'icon', icon: 'plus', size: 'sm', class: 'md:hidden' -%}
                      <span class="hidden md:block" data-sold-out="{{ 'products.product.sold_out' | t | escape }}">
                        {{- quick_add_label -}}
                      </span>
                    </span>
                  </button>
                {%- endform -%}
              {%- else -%}
                {%- render 'sleek-quick-add', product: product, section_id: section_id -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if show_countdown and product.metafields.theme.countdown.value != blank -%}
          {%- liquid
            assign now_time = 'now' | date: '%s' | times: 1
            assign countdown_time = product.metafields.theme.countdown.value | date: '%s' | times: 1
          -%}
          {%- if countdown_time > now_time -%}
            <div class="product-card__countdown hidden sm:flex justify-center absolute w-full z-0 pointer-events-none no-js-hidden">
              <div class="button icon-with-text">
                <div class="btn-text">
                  {%- render 'icon', icon: 'countdown-compact', size: 'sm', class: 'flex-auto hidden md:block' -%}
                  <countdown-timer
                    class="flex gap-3"
                    data-expires="{{ product.metafields.theme.countdown.value | date: '%FT%T%:z' | escape }}"
                    data-compact="true"
                  >
                    <div class="countdown__item">
                      <p>--{{ 'general.date.d' | t }}</p>
                    </div>
                    <div class="countdown__item">
                      <p>--{{ 'general.date.h' | t }}</p>
                    </div>
                    <div class="countdown__item">
                      <p>--{{ 'general.date.m' | t }}</p>
                    </div>
                    <div class="countdown__item">
                      <p>--{{ 'general.date.s' | t }}</p>
                    </div>
                  </countdown-timer>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="product-card__media h-auto overflow-hidden">
        <span class="block aspect-{{ image_ratio }}"></span>
      </div>
    {%- endif -%}
    <div class="product-card__content grow flex flex-col{% if featured_media %} justify-start text-{{ settings.card_text_alignment }}{% else %} justify-center items-center absolute top-0 left-0 w-full h-full{% endif %}">
      {%- if show_vendor -%}
        <div class="product-card__top w-full">
          <span class="sr-only">{{ 'general.accessibility.vendor' | t }}</span>
          {{- product.vendor | link_to_vendor : class: "caption reversed-link uppercase leading-none tracking-widest" -}}
        </div>
      {%- endif -%}

      {%- comment -%}
        Products with no colourway in their title — the tees, the hoodies —
        leave the meta row holding nothing but the price, which then sits on a
        line of its own under the title, flush left, reading as a stray second
        line rather than a price. The modifier lifts it up beside the title, so
        it is right-aligned on those cards exactly as it is on the ones that do
        carry a colourway. See onrepeat-product-card.css.
      {%- endcomment -%}
      <div class="product-card__details flex flex-col w-full{% if card_colour == blank %} product-card__details--no-colour{% endif %}">
        <p class="grow">
          <a class="product-card__title reversed-link" href="{{ product_url }}">
            {{- card_title | escape -}}
          </a>
        </p>

        {%- comment -%}
          Colour left, price right. With no colourway the row has a single child,
          and `space-between` then leaves the price flush left exactly as before.
        {%- endcomment -%}
        <div class="product-card__meta">
          {%- if card_colour != blank -%}
            <span class="product-card__colour">{{ card_colour | escape }}</span>
          {%- endif -%}
          {%- render 'product-price', product: product, no_decimals: true, class: 'product-card__price flex flex-wrap items-baseline gap-2' -%}
        </div>

        {%- if card_rating_show -%}
          <div class="product-card__rating-inline" title="{{ 'general.accessibility.star_reviews_count' | t: count: rating_count | escape }}">
            <span role="img" aria-label="{{ 'general.accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max }}">
              {%- render 'icon', icon: 'star', size: 'xs' -%}
            </span>
            <b>{{ rating_value }}</b>
            {%- if rating_count > 0 -%}
              <span class="product-card__rating-count">({{ rating_count }})</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if sizes_list.size > 0 -%}
          {%- comment -%}
            Labelled with the product's own option name ("Size"), which the
            merchant already maintains per language — the theme has no
            translation key for this and inventing one would leak
            "Translation missing" into every locale but English.
          {%- endcomment -%}
          <div class="product-card__sizes" role="group" aria-label="{{ size_option_name | escape }}">
            {%- for size_value in sizes_list -%}
              {%- comment -%}
                `sizes_all` opens with the delimiter, and Liquid's split keeps a
                leading empty member (it only trims trailing ones), so the first
                entry is "" and would otherwise render an empty chip.
              {%- endcomment -%}
              {%- if size_value == blank -%}{%- continue -%}{%- endif -%}
              {%- capture size_key -%}|{{ size_value }}|{%- endcapture -%}
              {%- assign size_live = false -%}
              {%- if sizes_live contains size_key -%}
                {%- assign size_live = true -%}
              {%- endif -%}
              <span class="product-card__size{% unless size_live %} is-out{% endunless %}">
                {{- size_value | escape -}}
                {%- unless size_live -%}
                  <span class="sr-only"> — {{ 'products.product.sold_out' | t }}</span>
                {%- endunless -%}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product.quantity_price_breaks_configured? -%}
          <div class="text-sm font-medium leading-tight">{{ 'products.volume_pricing.note' | t }}</div>
        {%- endif -%}
      </div>

      {%- comment -%}
        Colourway swatches from custom.colour_siblings. Plain <a> links only — no
        per-card JS listener. Outputs nothing (and reserves no height) when the
        metafield is missing, so cards without siblings keep their current height.

        max_visible: 8 is a guard rail, not the fitting mechanism — the row is a
        horizontal scroller (see assets/colour-swatches.css), so six colourways
        are all reachable on one line. Beyond eight, the tail collapses into a
        "+N" link rather than asking anyone to swipe through a dozen dots.
      {%- endcomment -%}
      {%- render 'colour-swatches', product: product, size: 'small', max_visible: 8 -%}

      {%- if show_color_swatches -%}
        {%- liquid
          assign swatch_trigger_list = 'products.general.color_swatch_trigger' | t | downcase | split: ','
          assign swatch_file_extension = 'png'
          assign color_count = 0
        -%}
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign is_color = false
            assign option_name = option.name | downcase
            for trigger in swatch_trigger_list
              assign swatch_trigger = trigger | strip
              if option_name contains swatch_trigger
                assign is_color = true
              elsif swatch_trigger == 'color' and option_name contains 'colour'
                assign is_color = true
              endif

              if is_color == true
                break
              endif
            endfor
          -%}
          {%- if is_color -%}
            {%- liquid
              assign option_index = forloop.index0
              assign values = ''
              assign max_color_count = settings.product_max_color_swatches
            -%}
            <div class="product-card__bottom flex items-center gap-2">
              <ul class="swatches swatches--{{ settings.rounded_swatch }}{% if settings.product_color_swatch_type == 'variant' %} swatches--variant{% endif %} swatches--{{ product.id }} inline-flex items-start gap-2">
                {%- for variant in product.variants -%}
                  {%- assign value = variant.options[option_index] %}
                  {%- unless values contains value -%}
                    {%- liquid
                      assign values = values | join: ',' | append: ',' | append: value | split: ','
                      assign color_count = color_count | plus: 1
                      assign color_title = product.title | append: ' - ' | append: value
                      assign color_url = variant.url | within: collection
                      if settings.product_disable_collection_portion
                        assign color_url = variant.url
                      endif

                      assign swatch = blank
                      if value.swatch != blank
                        assign swatch = value.swatch
                      endif

                      if settings.product_color_swatch_type == 'variant' and variant.image
                        assign swatch = variant
                      endif
                    -%}
                    {%- if color_count <= max_color_count -%}
                      <li>
                        {%- render 'swatch', href: color_url, title: color_title, value: value, file_extension: swatch_file_extension, swatch: swatch -%}
                      </li>
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
              {%- if color_count > max_color_count -%}
                <a href="{{ product_url }}" class="reversed-link font-medium text-xs text-opacity leading-none tracking-widest" is="hover-link" aria-controls="Quickview-{{ section_id }}-{{ product_id }}" aria-expanded="false">+{{ color_count | minus: max_color_count }}</a>
              {%- endif -%}
            </div>
            {%- if color_count < 1 -%}
              <style>
                .swatches--{{ product.id }} { display: none; }
              </style>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%}
      Sold-out cards render no mobile quick-add at all: there is nothing to add,
      and the disabled "Sold Out" span that used to sit here was a third printing
      of a word the badge already carries.
    {%- endcomment -%}
    {%- if show_quick_add and mobile_quick_add and product.available -%}
      <div class="lg:hidden">
        {%- if product.variants.size == 1 -%}
          {%- capture product_form_id -%}MobileQuickAddProductForm-{{ section_id }}-{{ product_id }}{%- endcapture -%}
          {%- form 'product', product, is: 'product-form', id: product_form_id -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
            <button type="submit" class="button button--primary button--small icon-with-text" is="hover-button" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- liquid
                  render 'icon', icon: 'plus', size: '2xs'
                  echo 'products.product.quick_add' | t
                -%}
              </span>
            </button>
          {%- endform -%}
        {%- else -%}
          {%- render 'sleek-quick-add', product: product, section_id: section_id, is_mobile: true -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- else -%}
  {%- render 'product-card-placeholder', placeholder: 'image', image_ratio: image_ratio, text_alignment: text_alignment, show_vendor: show_vendor, show_rating: show_rating -%}
{%- endif -%}
