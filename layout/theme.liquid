  <!-- Script Interceptor to Optimize Third-Party Performance -->
  <script>
    (function() {
      var originalCreateElement = document.createElement;
      var delayedScripts = [];
      var userInteracted = false;

      var trackerDomains = [
        'googletagmanager.com',
        'google-analytics.com',
        'analytics.google.com',
        'clarity.ms',
        'adnabu-shopify',
        'fbevents',
        'connect.facebook.net'
      ];

      // Dropped outright rather than deferred. Wigzo (a Shiprocket property) is not an app on
      // this store and is referenced nowhere in this theme — it arrives via a legacy Shopify
      // ScriptTag that outlived whatever installed it. It pulls 372 KB with its own jQuery for
      // web push, exit-intent popups and behavioural tracking, and ships a global
      // `em { font-style: italic !important }` that overrides this theme's highlight styling.
      // Blocking has to happen here: this interceptor puts an OWN src accessor on every script
      // element, and an own property outranks any guard defined on HTMLScriptElement.prototype,
      // so nothing outside this function can intervene while it is installed.
      var blockedDomains = [
        'wigzo.com',
        'wigzopush.com'
      ];

      document.createElement = function(tagName) {
        var element = originalCreateElement.apply(document, arguments);
        if (tagName.toLowerCase() === 'script') {
          var originalSetAttribute = element.setAttribute;
          element.setAttribute = function(name, value) {
            if (name === 'src' && shouldBlock(value)) return;
            if (name === 'src' && shouldDelay(value)) {
              element.dataset.delayedSrc = value;
              delayedScripts.push(element);
              return;
            }
            originalSetAttribute.apply(element, arguments);
          };
          Object.defineProperty(element, 'src', {
            get: function() {
              return element.getAttribute('src') || element.dataset.delayedSrc;
            },
            set: function(value) {
              if (shouldBlock(value)) return;
              if (shouldDelay(value)) {
                element.dataset.delayedSrc = value;
                delayedScripts.push(element);
              } else {
                element.setAttribute('src', value);
              }
            }
          });
        }
        return element;
      };

      function shouldBlock(src) {
        if (!src) return false;
        var s = String(src);
        return blockedDomains.some(function(domain) {
          return s.indexOf(domain) > -1;
        });
      }

      function shouldDelay(src) {
        if (!src || userInteracted) return false;
        return trackerDomains.some(function(domain) {
          return src.indexOf(domain) > -1;
        });
      }

      // Once createElement stops wrapping, script elements no longer carry an own src accessor,
      // so a guard on the prototype finally takes effect. Installed at handover so the block
      // outlives this interceptor: the ScriptTag loader fires on window load, which on a heavy
      // page routinely lands after the 4s timeout or the first scroll has already restored
      // createElement — the window Wigzo was slipping through.
      function installPersistentBlock() {
        try {
          var native = Object.getOwnPropertyDescriptor(HTMLScriptElement.prototype, 'src');
          if (!native || !native.get || !native.set) return;
          Object.defineProperty(HTMLScriptElement.prototype, 'src', {
            configurable: true,
            enumerable: native.enumerable,
            get: function() { return native.get.call(this); },
            set: function(value) { if (shouldBlock(value)) return; native.set.call(this, value); }
          });
        } catch (e) {}
      }

      function triggerDelayedScripts() {
        if (userInteracted) return;
        userInteracted = true;

        // Restore original createElement
        document.createElement = originalCreateElement;
        installPersistentBlock();

        // Load all delayed scripts
        delayedScripts.forEach(function(element) {
          if (element.dataset.delayedSrc) {
            element.setAttribute('src', element.dataset.delayedSrc);
            delete element.dataset.delayedSrc;
          }
        });
        delayedScripts = [];
        removeListeners();
      }

      var events = ['mouseover', 'keydown', 'touchstart', 'touchmove', 'click', 'scroll'];
      function removeListeners() {
        events.forEach(function(e) {
          window.removeEventListener(e, triggerDelayedScripts, { passive: true });
        });
      }

      events.forEach(function(e) {
        window.addEventListener(e, triggerDelayedScripts, { passive: true });
      });

      // Fallback load after 4 seconds of idle time
      setTimeout(triggerDelayedScripts, 4000);
    })();
  </script>
