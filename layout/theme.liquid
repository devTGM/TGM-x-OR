{%- comment -%}
  Checkout routing is decided at render time, so a page restored from the
  back-forward cache carries whichever checkout was correct when it was built.
  Switch market, press Back, and the browser can hand you an INR page with
  Magic already bound while you are now in the US context — or a USD page with
  no Magic while you are back on INR. The second of those is the one the
  merchant's rule forbids outright.

  `pageshow` with `persisted` is the only event that fires for a bfcache
  restore. The `localization` cookie is the country Shopify will render next;
  if it no longer matches what this page was built for, the page is stale for
  routing purposes and is reloaded. Normal loads (`persisted === false`) do
  nothing, so this costs nothing on the hot path.

  The cookie is SameSite=Lax and not HttpOnly, so it is readable here. If it
  cannot be read the guard stays silent rather than reloading blindly — a
  reload loop would be worse than the stale page it is trying to fix.
{%- endcomment -%}
<script>
  (function () {
    var rendered = {{ localization.country.iso_code | json }};
    addEventListener('pageshow', function (event) {
      if (!event.persisted) return;
      var match = document.cookie.match(/(?:^|;\s*)localization=([^;]+)/);
      if (!match) return;
      var current;
      try { current = decodeURIComponent(match[1]).toUpperCase(); } catch (e) { return; }
      if (current && rendered && current !== rendered) location.reload();
    });
  })();
</script>
