    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Q: What size should I choose?",
            "text": "<p>A: Most of our pieces have an oversized or relaxed fit. Check the size chart on the product page or DM us for personalized sizing help.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "<strong>Q: What materials do you use?</strong>",
            "text": "<p>A: We use premium fabrics like heavyweight cotton, denim, and blends — all selected for durability, comfort, and style. Fabric details are listed under each product.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "<strong>Q: How do I care for this piece?</strong>",
            "text": "<p>A: Most items are best washed cold and inside out. Avoid tumble drying to preserve prints and structure. Specific care instructions are included on the garment label.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "title": "<strong>Q: Is this item restocking?</strong>",
            "text": "<p>A: Many of our drops are limited. If it’s marked \"sold out,\" it may not return. Follow us on Instagram or sign up for restock alerts to stay updated.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "title": "<strong>Q: How long will it take to arrive?</strong>",
            "text": "<p>A: Orders are dispatched in 1–2 business days. Standard delivery within India usually takes 3–7 business days.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "contact": {
