          }
        },
        "content-4": {
          "type": "content",
          "settings": {
            "icon": "phone",
            "heading": "Contact Us",
            "text": "<p>We’d love to hear from you. Whether it’s feedback, inquiries, or just saying hi — our team is here to help.<br/><br/>Head over to our <a href=\"/pages/contact\" title=\"Contact\"><strong>Contact page</strong></a> to send us a message.</p>",
