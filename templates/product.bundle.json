          }
        },
        "content-3": {
          "type": "content",
          "settings": {
            "icon": "chat_bubble",
            "heading": "FAQ’s",
            "text": "<p>For quick answers to common questions — from sizing and shipping to returns and care — <strong>visit the </strong><a href=\"/pages/faq\" title=\"FAQ\"><strong>FAQ</strong></a><strong> Page</strong><br/><br/>We’ve got you covered.</p>",
            "highlighted_text": "none",
