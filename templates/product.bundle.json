          }
        },
        "content-2": {
          "type": "content",
          "settings": {
            "icon": "headphone",
            "heading": "Customer Support",
            "text": "<p>Connect with us via <strong>email, phone, or Instagram DMs</strong> — whichever works best for you.</p><p>🕐 We're available <strong>Monday to Friday | 10 AM – 7 PM IST</strong></p>",
