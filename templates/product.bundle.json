    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Q: How do I pick sizes for each item in the pack?",
            "text": "<p>A: Each of the 5 t-shirts has its own size selector above the Add-to-Cart button. Pick the size you want for each item — they don't have to be the same size.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "<strong>Q: Can I swap an item in the pack for a different design?</strong>",
            "text": "<p>A: The pack contents are fixed — all 5 t-shirts ship together as a curated set. You can choose the size for each, but the designs are predetermined for the bundle price.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "<strong>Q: What materials are used?</strong>",
            "text": "<p>A: We use premium heavyweight cotton across all 5 t-shirts — selected for durability, comfort, and a flawless print finish. Fabric details are listed on each component product page.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "title": "<strong>Q: How do I care for these?</strong>",
            "text": "<p>A: Wash cold, inside out. Avoid tumble drying to preserve prints and structure. Specific care instructions are included on each garment's label.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "title": "<strong>Q: How long will the pack take to arrive?</strong>",
            "text": "<p>A: Orders are dispatched in 1–2 business days. Standard delivery within India usually takes 3–7 business days. All 5 items ship together.</p>",
