            "subheading": "9th century",
            "heading": "",
            "heading_tag": "h2",
            "text": "<p><strong>al-Khwārizmī</strong> carries the system west into the Arab world. His name survives in English as the word <em>algorithm.</em></p>",
            "button_label": "",
            "button_link": "",
            "button_style": "link",
