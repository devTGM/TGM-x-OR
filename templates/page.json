    "rich_text_c8mMDx": {
      "type": "rich-text",
      "blocks": {
        "heading_YB9nga": {
          "type": "heading",
          "settings": {
            "heading": "<em>03 </em>| THE FOUNDING",
            "heading_size": "title-sm",
            "heading_tag": "h2",
            "highlighted_text": "text",
            "highlighted_scribble": "circle"
          }
        },
        "text_aMLaPW": {
          "type": "text",
          "settings": {
            "text": "<p><strong>I </strong>grew up being told our philosophy was history. Something to study in a classroom, recite at a festival, and leave there. Something to be proud of from a distance.</p><p><strong>I </strong>didn't want to sell heritage as costume. Printing a deity on a hoodie is not reverence, it's decoration. <strong>I </strong>wanted to make clothing that could hold an idea the way the idea itself works — quiet from across the room, deep when you look closer.</p><p>So <em>we</em> started with the hardest word <em>we</em> had. <em>We</em> began from zero. Not as a slogan. As a method.</p>",
            "text_size": "subtext-sm",
            "text_max_size": 32,
            "text_font": "body",
            "secondary_color": false,
            "highlighted_text": "text",
            "highlighted_scribble": "circle"
          }
        },
        "text_49BhqR": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Paras Soni</strong><br/><em>Founder</em> · Bharat, 2024</p>",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_font": "body",
